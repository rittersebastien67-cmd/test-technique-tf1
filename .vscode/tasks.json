{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/LeaveManagement.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/LeaveManagement.slnx", "/property:GenerateFullPaths=true"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: project",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/${input:testProject}/${input:testProject}.csproj", "/property:GenerateFullPaths=true"],
      "group": "test",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      "id": "testProject",
      "type": "pickString",
      "description": "Test project to run",
      "options": [
        "Architecture.Tests",
        "HrAdministration.Domain.Tests",
        "HrAdministration.Application.Tests",
        "HrAdministration.Infrastructure.Tests",
        "HrAdministration.Api.Tests",
        "Assistant.Domain.Tests",
        "Assistant.Application.Tests",
        "Payroll.Application.Tests"
      ],
      "default": "HrAdministration.Domain.Tests"
    }
  ]
}
